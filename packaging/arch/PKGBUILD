# Maintainer: Suhas Dissanayake <suhasdissa@gmail.com>
pkgname=prism
pkgver=0.1.2
pkgrel=1
pkgdesc="Qt6 live media mixer/switcher with FFmpeg, OpenGL and a dark Resolume-inspired UI"
arch=('x86_64')
url="https://github.com/CutWire-Studios/Prism"
license=('GPL-3.0-or-later')
depends=(
    'qt6-base' 'qt6-svg' 'qt6-multimedia' 'qt6-multimedia-ffmpeg'
    'qt6-serialport' 'qt6-websockets'
    'ffmpeg' 'gstreamer' 'gst-plugins-base'
    # Screen capture (ScreenSource_linux.cpp) and audio loopback capture
    # (AudioLoopbackCapture_gst_linux.cpp) both need the pipewiresrc GStreamer
    # element at runtime; nothing else in this list pulls it in transitively.
    'gst-plugin-pipewire'
    're2' 'libzip' 'soundtouch' 'lua54' 'openssl'
    # What the Skia archives built in build() link against at runtime; most are already pulled
    # in by qt6-base, they are listed so the ABI pin is explicit.
    'harfbuzz' 'icu' 'expat' 'libpng' 'fontconfig' 'freetype2'
)
optdepends=(
    'intel-media-driver: VAAPI hardware decode/encode on Intel GPUs'
    'libva-mesa-driver: VAAPI hardware decode/encode on AMD GPUs'
    'nvidia-utils: NVDEC hardware decode and NVENC recording on NVIDIA GPUs'
    'qt6-imageformats: WebP/TIFF stills without the FFmpeg fallback'
)
# clang, gn and python drive third_party/build-skia.sh; Skia's GN toolchain files are written
# for clang, so gcc is not an option there even though it builds Prism itself.
makedepends=('cmake' 'ninja' 'git' 'pkgconf' 'clang' 'gn' 'python')
# Defaults to the tagged release; CI overrides _commit (e.g. to $GITHUB_SHA)
# to build the exact commit that triggered the workflow instead.
_commit="${_commit:-v$pkgver}"
# Must match SKIA_COMMIT / SKIA_SHA256 in third_party/build-skia.sh; the script is handed this
# extracted tree so it never downloads anything during build().
_skia_commit=e7c90ecca9444fe09598f1630ab7cee2c0ee027a
source=("$pkgname::git+https://github.com/CutWire-Studios/Prism.git#commit=$_commit"
        "skia-$_skia_commit.tar.gz::https://github.com/google/skia/archive/$_skia_commit.tar.gz")
sha256sums=('SKIP'
            '7b5158952ebc4e2ce8de19f036b7613e266705003469579d9e98070ead62fc3b')

pkgver() {
    cd "$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

# ONNX Runtime has no Arch package; CMakeModules/FetchOnnxRuntime.cmake
# auto-downloads a prebuilt release when it isn't found, and only Windows
# gets a post-build copy-next-to-exe step for it (CMakeLists.txt's
# `if(WIN32)` block) — package() below bundles the fetched .so into
# /usr/lib/prism and points Prism at it via RPATH, mirroring what the
# AppImage workflow does with LD_LIBRARY_PATH.
_onnxruntime_libdir_glob="onnxruntime/onnxruntime-linux-x64-*/lib"

build() {
    cd "$pkgname"
    CC=clang CXX=clang++ JOBS="$(nproc)" SKIA_SRC_DIR="$srcdir/skia-$_skia_commit" \
        third_party/build-skia.sh linux-x64
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath,/usr/lib/prism" \
        -DPRISM_WITH_NDI=OFF \
        -DPRISM_WITH_WEBRTC=ON \
        -DPRISM_WITH_SEGMENTATION=ON
    cmake --build build --target Prism --target juice --target datachannel --parallel
}

package() {
    cd "$pkgname"
    DESTDIR="$pkgdir" cmake --install build

    install -d "$pkgdir/usr/lib/prism"
    install -m644 build/_deps/${_onnxruntime_libdir_glob}/libonnxruntime.so.* \
        "$pkgdir/usr/lib/prism/"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
