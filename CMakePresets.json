{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "dev",
      "displayName": "Dev (clang + lld, Debug, fast QML)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "PRISM_LINKER": "lld",
        "PRISM_QML_CACHEGEN": "OFF"
      }
    },
    {
      "name": "dev-gcc",
      "displayName": "Dev (gcc, Debug, fast QML)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-dev-gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "PRISM_LINKER": "auto"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "CI Linux (clang + lld, Release)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "PRISM_LINKER": "lld"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "dev-gcc", "configurePreset": "dev-gcc" },
    { "name": "ci-linux", "configurePreset": "ci-linux" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "ci-linux", "configurePreset": "ci-linux", "output": { "outputOnFailure": true } }
  ]
}
