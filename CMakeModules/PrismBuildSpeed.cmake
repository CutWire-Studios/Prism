if(MSVC OR ANDROID OR EMSCRIPTEN)
    return()
endif()

include(CheckLinkerFlag)

set(PRISM_LINKER "auto" CACHE STRING "Linker: auto, mold, lld, gold or default")
set_property(CACHE PRISM_LINKER PROPERTY STRINGS auto mold lld gold default)

set(_prism_linker "default")
if(PRISM_LINKER STREQUAL "auto")
    if(NOT APPLE)
        foreach(_cand lld mold gold)
            check_linker_flag(CXX "-fuse-ld=${_cand}" PRISM_LINKER_HAS_${_cand})
            if(PRISM_LINKER_HAS_${_cand})
                set(_prism_linker ${_cand})
                break()
            endif()
        endforeach()
    endif()
elseif(NOT PRISM_LINKER STREQUAL "default")
    check_linker_flag(CXX "-fuse-ld=${PRISM_LINKER}" PRISM_LINKER_HAS_${PRISM_LINKER})
    if(NOT PRISM_LINKER_HAS_${PRISM_LINKER})
        message(FATAL_ERROR "PRISM_LINKER=${PRISM_LINKER} is not supported by this compiler/toolchain")
    endif()
    set(_prism_linker ${PRISM_LINKER})
endif()
if(NOT _prism_linker STREQUAL "default")
    add_link_options("-fuse-ld=${_prism_linker}")
endif()
message(STATUS "Prism linker: ${_prism_linker}")

option(PRISM_CCACHE "Use ccache as the compiler launcher when available" ON)
if(PRISM_CCACHE AND NOT CMAKE_CXX_COMPILER_LAUNCHER)
    find_program(PRISM_CCACHE_PROGRAM ccache)
    if(PRISM_CCACHE_PROGRAM)
        set(CMAKE_C_COMPILER_LAUNCHER "${PRISM_CCACHE_PROGRAM}")
        set(CMAKE_CXX_COMPILER_LAUNCHER "${PRISM_CCACHE_PROGRAM}")
        message(STATUS "Prism ccache: ${PRISM_CCACHE_PROGRAM}")
    endif()
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Debug" AND NOT APPLE)
    set(_prism_split_dwarf ON)
else()
    set(_prism_split_dwarf OFF)
endif()
option(PRISM_SPLIT_DWARF "Emit split DWARF debug info in Debug builds" ${_prism_split_dwarf})
if(PRISM_SPLIT_DWARF AND NOT APPLE)
    add_compile_options("$<$<CONFIG:Debug>:-gsplit-dwarf>")
    if(_prism_linker MATCHES "^(mold|lld|gold)$")
        add_link_options("$<$<CONFIG:Debug>:LINKER:--gdb-index>")
    endif()
endif()
